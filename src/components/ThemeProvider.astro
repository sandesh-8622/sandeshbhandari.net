{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function getStoredMode() {
		if (typeof localStorage !== "undefined") {
			return localStorage.getItem("theme-mode") || "system";
		}
		return "system";
	}

	function getEffectiveTheme(mode) {
		if (mode === "system") {
			return lightModePref.matches ? "light" : "dark";
		}
		return mode;
	}

	function applyTheme(mode) {
		const effectiveTheme = getEffectiveTheme(mode);
		const root = document.documentElement;
		root.setAttribute("data-theme", effectiveTheme);

		if (typeof localStorage !== "undefined") {
			localStorage.setItem("theme-mode", mode);
		}
	}

	// initial setup
	applyTheme(getStoredMode());

	// View Transitions hook to restore theme
	document.addEventListener("astro:after-swap", () => applyTheme(getStoredMode()));

	// listen for theme-change custom event
	document.addEventListener("theme-change", (e) => {
		applyTheme(e.detail.theme);
	});

	// listen for OS preference change — only matters in system mode
	lightModePref.addEventListener("change", () => {
		if (getStoredMode() === "system") {
			applyTheme("system");
		}
	});
</script>
