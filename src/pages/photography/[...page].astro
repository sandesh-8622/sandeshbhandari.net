---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/Paginator.astro";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_PHOTOS_PER_PAGE = 18;
	const allPhotos = await getCollection("photography");
	return paginate(allPhotos.sort(collectionDateSort), { pageSize: MAX_PHOTOS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"photography">>;
}

const { page } = Astro.props;

const meta = {
	description: "Browse my photography portfolio",
	title: "Photography",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Page",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Page →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-8">Photography</h1>
		<ul class="grid grid-cols-2 gap-2 md:grid-cols-3" role="list">
			{
				page.data.map((photo, i) => (
					<li>
						<a
							href={`/photography/${photo.id}/`}
							class="group relative block aspect-square overflow-hidden rounded-sm"
						>
							<img
								src={photo.data.src}
								alt={photo.data.alt}
								class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
								loading={i < 6 ? "eager" : "lazy"}
								decoding="async"
							/>
							<div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
								<div class="p-4">
									<p class="text-sm font-medium text-white">{photo.data.title}</p>
									{photo.data.category && (
										<span class="text-xs uppercase tracking-wider text-white/70">
											{photo.data.category}
										</span>
									)}
								</div>
							</div>
						</a>
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
