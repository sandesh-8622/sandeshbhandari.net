---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Projects and experience by Sandesh Bhandari",
	title: "My Projects",
};

const projects = [
	{
		title: "Volunteer IT Technician",
		subtitle: "3D Technology Department, Chain For Change (CFC) - Project Wings to Dreams",
		description:
			"I collaborated on creating 3D-printed tools, including tactile models for visually impaired students. Our work garnered national recognition, featuring in major newspapers and articles that highlighted our team's impact. Additionally, I authored concept papers and collaborated on research supporting inclusive educational practices.",
		tags: ["3D Printing", "Research", "Education"],
		link: "",
	},
	{
		title: "Research Assistant",
		subtitle: "IAMP, University of Idaho",
		description:
			"As an undergraduate research assistant at IAMP, University of Idaho, I collaborate with a team to analyze agricultural data using Python and R, developing climate-resilient models to enhance sustainability and improve yield efficiency.",
		tags: ["Python", "R", "Data Analysis", "Research"],
		link: "",
	},
	{
		title: "Video Editor",
		subtitle: "Content Creation",
		description:
			"I created core videos on gaming and philosophy, emphasizing motion graphics, color grading, and sound design using tools like Premiere Pro, DaVinci Resolve, and Photoshop while honing my writing skills.",
		tags: ["Premiere Pro", "DaVinci Resolve", "Photoshop"],
		link: "",
	},
	{
		title: "Class 12 NEB Guide App",
		subtitle: "React Native",
		description:
			"I worked as a front-end developer to build a mobile app using React Native. The app featured offline access, advanced search, and real-time updates through CMS, providing students with seamless access to study materials.",
		tags: ["React Native", "Mobile", "CMS"],
		link: "https://play.google.com/store/apps/details?id=com.guide.nebtwelve",
	},
];
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-12">
			<h1 class="title mb-4">My Projects</h1>
			<p>
				Here are some of the projects that I've made while I was learning
				some new technologies/frameworks or any libraries.
			</p>
		</div>
		<ul class="grid gap-6 sm:grid-cols-2" role="list">
			{
				projects.map((project) => (
					<li class="bg-global-text/5 flex flex-col rounded-md p-5">
						{project.link ? (
							<a href={project.link} target="_blank" rel="noreferrer" class="contents">
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<p class="mb-4 flex-1 text-sm leading-relaxed">{project.description}</p>
								<span class="cactus-link mt-auto inline-block text-sm">
									Check Out &rarr;
								</span>
							</a>
						) : (
							<>
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<p class="mb-4 flex-1 text-sm leading-relaxed">{project.description}</p>
							</>
						)}
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
