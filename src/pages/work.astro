---
import { projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Projects and experience by Sandesh Bhandari",
	title: "My Projects",
};
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-12">
			<h1 class="title mb-4">My Projects</h1>
			<p>
				Here are some of the projects that I've made while I was learning
				some new technologies/frameworks or any libraries.
			</p>
		</div>
		<ul class="grid gap-6 sm:grid-cols-2" role="list">
			{
				projects.map((project) => (
					<li>
						{project.link ? (
							<a
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
								class="bg-global-text/5 border-global-text/20 hover:bg-global-text/10 hover:border-global-text/40 flex h-full flex-col rounded-md border p-5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
							>
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<p class="mb-4 flex-1 text-sm leading-relaxed">{project.description}</p>
								<span class="cactus-link mt-auto inline-block text-sm">
									Check Out &rarr;
								</span>
							</a>
						) : (
							<div class="bg-global-text/5 border-global-text/20 flex h-full flex-col rounded-md border p-5">
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<p class="mb-4 flex-1 text-sm leading-relaxed">{project.description}</p>
							</div>
						)}
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>