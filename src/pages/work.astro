---
import { projects, work } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Work experience by Sandesh Bhandari",
	title: "Work",
};
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-12">
			<h1 class="title mb-4">Work</h1>
			<p>
				Here are the roles I've worked in, from internships and research
				assistantships to open-source contributions.
			</p>
		</div>
		<ul class="grid gap-6 sm:grid-cols-2" role="list">
			{
				work.map((project) => (
					<li class="bg-global-text/5 flex flex-col rounded-md p-5">
						{project.link ? (
							<a href={project.link} target="_blank" rel="noreferrer" class="contents">
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<div class="mb-4 space-y-1.5">
									{project.description.split("\n").map((line) => (
										<p class="text-sm leading-relaxed">{line}</p>
									))}
								</div>
								<span class="cactus-link mt-auto inline-block text-sm">
									Check Out &rarr;
								</span>
							</a>
						) : (
							<>
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h2 class="mb-3 text-lg font-medium">{project.title}</h2>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<div class="mb-4 space-y-1.5">
									{project.description.split("\n").map((line) => (
										<p class="text-sm leading-relaxed">{line}</p>
									))}
								</div>
							</>
						)}
					</li>
				))
			}
		</ul>
	</section>
	<section class="mt-16">
		<div class="mb-12">
			<h2 class="title mb-4">Projects</h2>
			<p>
				Things I've built for fun and for learning, while playing around with
				new technologies, frameworks, and libraries.
			</p>
		</div>
		<ul class="grid gap-6 sm:grid-cols-2" role="list">
			{
				projects.map((project) => (
					<li class="bg-global-text/5 flex flex-col rounded-md p-5">
						{project.link ? (
							<a href={project.link} target="_blank" rel="noreferrer" class="contents">
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h3 class="mb-3 text-lg font-medium">{project.title}</h3>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<div class="mb-4 space-y-1.5">
									{project.description.split("\n").map((line) => (
										<p class="text-sm leading-relaxed">{line}</p>
									))}
								</div>
								<span class="cactus-link mt-auto inline-block text-sm">
									Check Out &rarr;
								</span>
							</a>
						) : (
							<>
								<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
									{project.subtitle}
								</p>
								<h3 class="mb-3 text-lg font-medium">{project.title}</h3>
								<div class="mb-3 flex flex-wrap gap-1.5">
									{project.tags.map((tag) => (
										<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
											{tag}
										</span>
									))}
								</div>
								<div class="mb-4 space-y-1.5">
									{project.description.split("\n").map((line) => (
										<p class="text-sm leading-relaxed">{line}</p>
									))}
								</div>
							</>
						)}
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
