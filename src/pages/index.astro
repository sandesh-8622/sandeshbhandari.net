---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import { work } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Posts
const MAX_POSTS = 3;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Photography, set to a max of 6
const MAX_PHOTOS = 6;
const allPhotos = await getCollection("photography");
const latestPhotos = allPhotos
	.sort(collectionDateSort)
	.slice(0, MAX_PHOTOS) as CollectionEntry<"photography">[];
---

<PageLayout meta={{ title: "Sandesh Bhandari" }}>
	<section>
		<div class="prose prose-sm prose-cactus max-w-none">
			<h1 class="title mb-8">Hi,</h1>
		<p>
    I'm Sandesh. I'm a CS sophomore in the US, focused on building capable and reliable AI systems.
</p>
<p>
    Right now I'm working on language model agents, tool use, world models, and embodied robotics. I'm especially interested in the architectures and system designs that allow them to reason effectively, minimize errors, and truly understand tasks rather than just parrot patterns.
</p>
</p>
<p>
    <strong>Tech:</strong> C++, Python, Rust, ROS 2, MuJoCo, PyTorch, Linux
</p>
<p>
				In my free time I like playing
				<a class="cactus-link inline-block" href="https://lichess.org/@/sandesh3388" target="_blank" rel="noreferrer">chess</a>,
				listening to
				<a class="cactus-link inline-block" href="https://open.spotify.com/user/31ap2qieidautkrv7cg5agsr57qi?si=ec2c8d054b4a4719" target="_blank" rel="noreferrer">music</a>,
				reading
				<a class="cactus-link inline-block" href="https://www.goodreads.com/user/show/157024059-sandesh-bhandari" target="_blank" rel="noreferrer">books</a>
				and watching
				<a class="cactus-link inline-block" href="https://letterboxd.com/sandeshbhandari/" target="_blank" rel="noreferrer">films</a>.
				I'm not very active on
				<a class="cactus-link inline-block" href="https://www.instagram.com/sandesh2wavy/" target="_blank" rel="noreferrer">Instagram</a> but occasionally post on
				<a class="cactus-link inline-block" href="http://vsco.co/sandesh2wavy" target="_blank" rel="noreferrer">VSCO</a>.
				Check out my stuff below :)
			</p>
			<div class="not-prose">
				<SocialList />
			</div>
		</div>
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/posts/">Latest Blog</a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
		<div class="mt-6 text-right">
			<a href="/posts/" class="cactus-link text-sm">more &rarr;</a>
		</div>
	</section>
	{
		latestPhotos.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/photography/">Latest Photography</a>
				</h2>
				<ul class="grid grid-cols-2 gap-2 md:grid-cols-3" role="list">
					{latestPhotos.map((photo) => (
						<li>
							<a
								href={`/photography/${photo.id}/`}
								class="group block aspect-square overflow-hidden rounded-sm"
							>
								<img
									src={photo.data.src}
									alt={photo.data.alt}
									class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
									loading="lazy"
								/>
							</a>
						</li>
					))}
				</ul>
				<div class="mt-6 text-right">
					<a href="/photography/" class="cactus-link text-sm">more &rarr;</a>
				</div>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/work/">Work</a>
		</h2>
		<ul class="grid gap-4 sm:grid-cols-2" role="list">
			{
				work.map((project) => (
					<li class="bg-global-text/5 flex flex-col rounded-md p-5">
						<a
							href={project.link || "/work/"}
							target={project.link ? "_blank" : undefined}
							rel={project.link ? "noreferrer" : undefined}
							class="contents"
						>
							<p class="text-accent mb-1 text-xs font-medium uppercase tracking-wider">
								{project.subtitle}
							</p>
							<h3 class="mb-3 text-lg font-medium">{project.title}</h3>
							<div class="mb-3 flex flex-wrap gap-1.5">
								{project.tags.map((tag) => (
									<span class="bg-global-text/10 rounded px-2 py-0.5 text-xs">
										{tag}
									</span>
								))}
							</div>
							<p class="mb-4 flex-1 text-sm leading-relaxed">{project.description}</p>
							{project.link && (
								<span class="cactus-link mt-auto inline-block text-sm">
									Check Out &rarr;
								</span>
							)}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-6 text-right">
			<a href="/work/" class="cactus-link text-sm">more &rarr;</a>
		</div>
	</section>
</PageLayout>
